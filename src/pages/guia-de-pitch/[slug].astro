---
import { getCollection } from "astro:content";
import Base from "~/layouts/Base.astro";
import Breadcrumb from "~/components/Breadcrumb.astro";
import UseCaseCTA from "~/components/UseCaseCTA.astro";
import {
  articleSchema,
  breadcrumbSchema,
  faqSchema,
  howToSchema,
  organizationSchema,
  speakableSchema,
} from "~/lib/schema";

export async function getStaticPaths() {
  const guias = await getCollection("guias");
  const byId = new Map(guias.map((g) => [g.id, g]));
  return guias.map((guia) => ({
    params: { slug: guia.id },
    props: {
      guia,
      related: (guia.data.related ?? [])
        .map((id) => byId.get(id))
        .filter((g): g is NonNullable<typeof g> => Boolean(g))
        .map((g) => ({
          href: `/guia-de-pitch/${g.id}`,
          title: g.data.title,
          description: g.data.description,
        })),
    },
  }));
}

const { guia, related } = Astro.props;
const d = guia.data;
const path = `/guia-de-pitch/${guia.id}`;

const crumbs = [
  { name: "Início", url: "/" },
  { name: "Guia de pitch", url: "/guia-de-pitch" },
  { name: d.title, url: path },
];

const dateFmt = new Intl.DateTimeFormat("pt-BR", {
  day: "2-digit",
  month: "long",
  year: "numeric",
});

const jsonLd = [
  organizationSchema(),
  breadcrumbSchema(crumbs),
  articleSchema({
    headline: d.title,
    description: d.description,
    path,
    datePublished: d.publishedAt.toISOString(),
    dateModified: d.updatedAt?.toISOString(),
    authorName: d.author,
    image: d.ogImage,
    keywords: d.keywords,
  }),
  ...(d.framework
    ? [
        howToSchema({
          name: d.framework.name,
          description: d.framework.description,
          totalTime: d.framework.totalTime,
          steps: d.framework.steps,
        }),
      ]
    : []),
  ...(d.faq.length ? [faqSchema(d.faq)] : []),
  ...(d.answer || d.faq.length
    ? [
        speakableSchema({
          path,
          cssSelectors: [
            ...(d.answer ? [".resposta-rapida"] : []),
            ...(d.faq.length ? [".guia-faq"] : []),
          ],
        }),
      ]
    : []),
];
---

<Base
  title={d.title}
  description={d.description}
  path={path}
  type="article"
  image={d.ogImage}
  jsonLd={jsonLd}
  keywords={d.keywords}
  article={{
    publishedTime: d.publishedAt.toISOString(),
    modifiedTime: d.updatedAt?.toISOString(),
    author: d.author,
    section: d.category,
    tags: d.keywords,
  }}
>
  <Breadcrumb crumbs={crumbs} />

  <article class="mx-auto max-w-3xl px-6 py-20 md:py-28">
    <div class="flex flex-wrap items-center gap-3 text-xs text-paper/55">
      <span class="rounded-full border border-paper/15 px-3 py-1 font-semibold uppercase tracking-wider text-orange">
        {d.category}
      </span>
      <span>{d.hero.eyebrow}</span>
      <span aria-hidden="true">·</span>
      <time datetime={d.publishedAt.toISOString()}>{dateFmt.format(d.publishedAt)}</time>
    </div>

    <h1 class="mt-4 font-display text-4xl font-black leading-tight text-paper md:text-6xl">
      {d.hero.heading}
    </h1>
    <p class="mt-5 text-lg text-paper/75">{d.hero.subheading}</p>

    {d.answer && (
      <div class="resposta-rapida mt-8 rounded-2xl border border-paper/15 bg-paper/[0.05] p-6">
        <p class="text-xs font-bold uppercase tracking-wider text-orange">Resposta rápida</p>
        <p class="mt-2 text-lg leading-relaxed text-paper/90">{d.answer}</p>
      </div>
    )}

    {d.tldr.length > 0 && (
      <div class="mt-10 rounded-2xl border border-orange/30 bg-orange/[0.04] p-6">
        <p class="text-xs font-bold uppercase tracking-wider text-orange">TL;DR</p>
        <ul class="mt-3 space-y-2 text-paper/85">
          {d.tldr.map((line) => <li>• {line}</li>)}
        </ul>
      </div>
    )}

    <div class="mt-12 space-y-12">
      {d.sections.map((s) => (
        <section>
          <h2 class="font-display text-3xl font-black leading-tight text-paper">{s.heading}</h2>
          {s.paragraphs.map((p) => (
            <p class="mt-4 text-lg leading-relaxed text-paper/[0.78]">{p}</p>
          ))}
          {s.bullets && s.bullets.length > 0 && (
            <ul class="mt-4 space-y-2 text-paper/[0.78]">
              {s.bullets.map((b) => (
                <li class="flex gap-2">
                  <span aria-hidden="true" class="text-orange">•</span>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          )}
        </section>
      ))}
    </div>

    {d.framework && (
      <section class="mt-16">
        <h2 class="font-display text-3xl font-black text-paper">{d.framework.name}</h2>
        <p class="mt-3 text-paper/75">{d.framework.description}</p>
        <ol class="mt-8 space-y-5">
          {d.framework.steps.map((step, i) => (
            <li class="flex gap-4 rounded-2xl border border-paper/10 bg-paper/[0.03] p-6">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-orange/40 bg-orange/10 font-display text-lg font-black text-orange">
                {i + 1}
              </span>
              <div>
                <h3 class="font-display text-xl font-bold text-paper">{step.name}</h3>
                <p class="mt-1 text-paper/75">{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}

    {d.story && (
      <section class="mt-16 rounded-2xl border border-paper/10 bg-paper/[0.03] p-8">
        <p class="text-xs font-bold uppercase tracking-wider text-orange">Exemplo</p>
        <h2 class="mt-3 font-display text-2xl font-bold text-paper">{d.story.title}</h2>
        <p class="mt-3 text-sm text-paper/60">{d.story.context}</p>
        <blockquote class="mt-5 border-l-2 border-orange/55 pl-5 text-lg italic text-paper/85">
          {d.story.quote}
        </blockquote>
        <p class="mt-5 text-paper/75"><strong class="text-paper">Lição:</strong> {d.story.lesson}</p>
      </section>
    )}

    {d.mistakes && d.mistakes.length > 0 && (
      <section class="mt-16">
        <h2 class="font-display text-3xl font-black text-paper">Erros a evitar</h2>
        <ul class="mt-6 space-y-4">
          {d.mistakes.map((m) => (
            <li class="rounded-xl border border-paper/10 bg-paper/[0.02] p-5">
              <p class="font-semibold text-paper">✗ {m.title}</p>
              <p class="mt-1 text-paper/70">{m.detail}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    {d.faq.length > 0 && (
      <section class="mt-16">
        <h2 class="font-display text-3xl font-black text-paper">Perguntas frequentes</h2>
        <dl class="guia-faq mt-6 divide-y divide-paper/10">
          {d.faq.map((f) => (
            <div class="py-6">
              <dt class="font-display text-lg font-bold text-paper">{f.question}</dt>
              <dd class="mt-2 text-paper/75">{f.answer}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    {related.length > 0 && (
      <section class="mt-16 border-t border-paper/10 pt-10">
        <h2 class="font-display text-2xl font-bold text-paper">Continue lendo</h2>
        <div class="mt-6 grid gap-4 md:grid-cols-2">
          {related.map((r) => (
            <a
              href={r.href}
              class="group rounded-2xl border border-paper/10 bg-paper/[0.03] p-6 transition-all hover:border-orange/40 hover:bg-paper/[0.05]"
            >
              <h3 class="font-display text-lg font-bold text-paper group-hover:text-orange">{r.title}</h3>
              <p class="mt-2 text-sm text-paper/70">{r.description}</p>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>

  <UseCaseCTA
    title="Quer aplicar isso na próxima reunião?"
    subtitle="Os guias te preparam. O Pitchei te ajuda no momento — o copiloto que fala quando você precisa, em português."
  />
</Base>
