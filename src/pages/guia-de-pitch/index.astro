---
import { getCollection } from "astro:content";
import Base from "~/layouts/Base.astro";
import Breadcrumb from "~/components/Breadcrumb.astro";
import HubHero from "~/components/HubHero.astro";
import HubCardGrid from "~/components/HubCardGrid.astro";
import UseCaseCTA from "~/components/UseCaseCTA.astro";
import {
  breadcrumbSchema,
  collectionPageSchema,
  itemListSchema,
  organizationSchema,
} from "~/lib/schema";

const crumbs = [
  { name: "Início", url: "/" },
  { name: "Guia de pitch", url: "/guia-de-pitch" },
];

const guias = (await getCollection("guias")).sort(
  (a, b) => a.data.order - b.data.order,
);

const guiaItems = guias.map((g) => ({
  href: `/guia-de-pitch/${g.id}`,
  title: g.data.title,
  desc: g.data.description,
  badge: g.data.category,
}));

const jsonLd = [
  organizationSchema(),
  breadcrumbSchema(crumbs),
  collectionPageSchema({
    name: "Guia de pitch · Pitchei",
    description:
      "A arte do pitch, em guias práticos: como fazer um bom pitch, elevator pitch, storytelling e mais, em português, com estrutura e exemplos.",
    path: "/guia-de-pitch",
  }),
  itemListSchema({
    name: "Guia de pitch · Pitchei",
    description: "Guias práticos sobre a arte do pitch, em português.",
    path: "/guia-de-pitch",
    items: guias.map((g) => ({
      name: g.data.title,
      path: `/guia-de-pitch/${g.id}`,
    })),
  }),
];

const keywords = [
  "guia de pitch",
  "como fazer um pitch",
  "a arte do pitch",
  "elevator pitch",
  "storytelling no pitch",
  "técnicas de apresentação",
];
---

<Base
  title="Guia de pitch"
  description="A arte do pitch, em guias práticos: como fazer um bom pitch, elevator pitch, storytelling e mais, em português, com estrutura, exemplos e erros a evitar."
  path="/guia-de-pitch"
  jsonLd={jsonLd}
  keywords={keywords}
>
  <Breadcrumb crumbs={crumbs} />

  <HubHero
    eyebrow="Guia de pitch"
    title="A arte do pitch, na prática."
    subtitle="Guias diretos sobre como convencer quando a próxima frase pesa: estrutura, formatos, storytelling e os erros que derrubam a sua fala. Em português, com exemplos prontos para adaptar."
  />

  <HubCardGrid items={guiaItems} ctaLabel="Ler guia" />

  <UseCaseCTA
    title="Pronto pra aplicar na próxima conversa?"
    subtitle="Os guias te preparam. O Pitchei te ajuda no momento, o copiloto em pt-BR que fala quando você precisa."
  />
</Base>
