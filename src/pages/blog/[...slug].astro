---
import { getCollection, render } from "astro:content";
import Base from "~/layouts/Base.astro";
import Breadcrumb from "~/components/Breadcrumb.astro";
import UseCaseCTA from "~/components/UseCaseCTA.astro";
import {
  articleSchema,
  breadcrumbSchema,
  organizationSchema,
} from "~/lib/schema";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const path = `/blog/${post.id}`;
const crumbs = [
  { name: "Início", url: "/" },
  { name: "Blog", url: "/blog" },
  { name: post.data.title, url: path },
];

const dateFmt = new Intl.DateTimeFormat("pt-BR", {
  day: "2-digit",
  month: "long",
  year: "numeric",
});

const jsonLd = [
  organizationSchema(),
  breadcrumbSchema(crumbs),
  articleSchema({
    headline: post.data.title,
    description: post.data.description,
    path,
    datePublished: post.data.publishedAt.toISOString(),
    dateModified: post.data.updatedAt?.toISOString(),
    authorName: post.data.author,
    image: post.data.ogImage,
    keywords: post.data.keywords,
  }),
];
---

<Base
  title={post.data.title}
  description={post.data.description}
  path={path}
  type="article"
  image={post.data.ogImage}
  jsonLd={jsonLd}
  keywords={post.data.keywords}
  article={{
    publishedTime: post.data.publishedAt.toISOString(),
    modifiedTime: post.data.updatedAt?.toISOString(),
    author: post.data.author,
    section: post.data.section,
    tags: post.data.tags,
  }}
>
  <Breadcrumb crumbs={crumbs} />

  <article class="mx-auto max-w-3xl px-6 py-20 md:py-28">
    <div class="flex flex-wrap items-center gap-3 text-xs text-paper/55">
      {post.data.section && (
        <span class="rounded-full border border-paper/15 px-3 py-1 font-semibold uppercase tracking-wider text-orange">
          {post.data.section}
        </span>
      )}
      <time datetime={post.data.publishedAt.toISOString()}>
        {dateFmt.format(post.data.publishedAt)}
      </time>
      <span aria-hidden="true">·</span>
      <span>{post.data.author}</span>
    </div>

    <h1 class="mt-4 font-display text-4xl font-black leading-tight text-paper md:text-6xl">
      {post.data.title}
    </h1>
    <p class="mt-5 text-lg text-paper/75">{post.data.description}</p>

    {post.data.tldr && post.data.tldr.length > 0 && (
      <div class="mt-10 rounded-2xl border border-orange/30 bg-orange/[0.04] p-6">
        <p class="text-xs font-bold uppercase tracking-wider text-orange">TL;DR</p>
        <ul class="mt-3 space-y-2 text-paper/85">
          {post.data.tldr.map((line) => (
            <li>• {line}</li>
          ))}
        </ul>
      </div>
    )}

    <div class="prose-pitchei mt-12">
      <Content />
    </div>

    {post.data.tags && post.data.tags.length > 0 && (
      <div class="mt-16 flex flex-wrap items-center gap-2 border-t border-paper/10 pt-8 text-sm text-paper/55">
        <span>Tags:</span>
        {post.data.tags.map((tag) => (
          <span class="rounded-full border border-paper/15 px-3 py-1 text-paper/70">{tag}</span>
        ))}
      </div>
    )}
  </article>

  <UseCaseCTA
    title="Quer aplicar isso na próxima reunião?"
    subtitle="Pitchei te ajuda no momento — o copiloto que fala quando você precisa."
  />
</Base>

<style is:global>
  .prose-pitchei {
    color: rgb(247 243 238 / 0.78);
    font-size: 1.0625rem;
    line-height: 1.75;
  }
  .prose-pitchei > * + * {
    margin-top: 1.5rem;
  }
  .prose-pitchei h2 {
    color: rgb(247 243 238);
    font-family: var(--font-display, "Fraunces", serif);
    font-size: 1.875rem;
    font-weight: 900;
    line-height: 1.2;
    margin-top: 3rem;
  }
  .prose-pitchei h3 {
    color: rgb(247 243 238);
    font-family: var(--font-display, "Fraunces", serif);
    font-size: 1.375rem;
    font-weight: 800;
    line-height: 1.3;
    margin-top: 2.5rem;
  }
  .prose-pitchei p {
    line-height: 1.75;
  }
  .prose-pitchei strong {
    color: rgb(247 243 238);
    font-weight: 700;
  }
  .prose-pitchei em {
    font-style: italic;
  }
  .prose-pitchei ul,
  .prose-pitchei ol {
    padding-left: 1.5rem;
  }
  .prose-pitchei ul {
    list-style-type: disc;
  }
  .prose-pitchei ol {
    list-style-type: decimal;
  }
  .prose-pitchei ul li::marker,
  .prose-pitchei ol li::marker {
    color: rgb(232 93 38);
  }
  .prose-pitchei li {
    margin-top: 0.5rem;
  }
  .prose-pitchei a {
    color: rgb(232 93 38);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .prose-pitchei a:hover {
    color: rgb(255 122 69);
  }
  .prose-pitchei blockquote {
    border-left: 3px solid rgb(232 93 38 / 0.55);
    margin-left: 0;
    padding: 0.25rem 0 0.25rem 1.25rem;
    color: rgb(247 243 238 / 0.85);
    font-style: italic;
  }
  .prose-pitchei code {
    background: rgb(247 243 238 / 0.06);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.9em;
  }
</style>
