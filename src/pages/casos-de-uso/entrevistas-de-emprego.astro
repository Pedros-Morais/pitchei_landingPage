---
import Base from "~/layouts/Base.astro";
import Breadcrumb from "~/components/Breadcrumb.astro";
import UseCaseHero from "~/components/UseCaseHero.astro";
import UseCaseFAQ from "~/components/UseCaseFAQ.astro";
import UseCaseCTA from "~/components/UseCaseCTA.astro";
import {
  breadcrumbSchema,
  faqSchema,
  softwareApplicationSchema,
  organizationSchema,
} from "~/lib/schema";
import type { FAQItem } from "~/lib/schema";

const crumbs = [
  { name: "Início", url: "/" },
  { name: "Casos de uso", url: "/casos-de-uso" },
  { name: "Entrevistas de emprego", url: "/casos-de-uso/entrevistas-de-emprego" },
];

const faq: FAQItem[] = [
  {
    question: "Posso usar Pitchei em entrevista de emprego?",
    answer:
      "Sim. Pitchei foi pensado pra esses momentos: o recrutador faz uma pergunta comportamental, você sabe a resposta certa em algum lugar, e o Pitchei traz o exemplo do seu próprio histórico, estruturado no método STAR (Situação, Tarefa, Ação, Resultado), em português, na hora.",
  },
  {
    question: "O recrutador vai notar?",
    answer:
      "Não. O Pitchei roda no seu computador sem entrar na call. As sugestões aparecem na sua tela como um overlay sutil. Se você usa monitor secundário, fica ainda mais natural — você consulta como quem dá uma olhada no notebook de anotações.",
  },
  {
    question: "É ético usar IA durante uma entrevista?",
    answer:
      "Pitchei é uma ferramenta de preparação ativa, como um briefing aberto ao lado da tela. Você fornece os dados sobre você (CV, exemplos, salário-alvo), e o Pitchei só te ajuda a lembrar e formular. A resposta continua sendo sua. A decisão sobre transparência é sua e da empresa.",
  },
  {
    question: "Funciona em entrevista por telefone também?",
    answer:
      "Sim, se a ligação rolar no seu computador (FaceTime, Google Voice, Zoom Phone, integração com o celular). Pitchei captura o áudio do sistema, então qualquer canal que toque no computador é coberto.",
  },
  {
    question: "Posso configurar minha pretensão salarial antes?",
    answer:
      "Sim. Você define seu range salarial, sua experiência relevante, exemplos de projetos, e referências de cultura antes da entrevista. Quando vier a pergunta sobre pretensão, o Pitchei sugere a resposta que respeita o seu range — não algo aleatório.",
  },
];

const jsonLd = [
  organizationSchema(),
  softwareApplicationSchema(),
  breadcrumbSchema(crumbs),
  faqSchema(faq),
];

const keywords = [
  "entrevista de emprego",
  "respostas para entrevista",
  "entrevista comportamental",
  "método STAR",
  "como responder entrevista",
  "entrevista sob pressão",
  "preparação para entrevista",
  "pretensão salarial",
];
---

<Base
  title="Entrevistas de emprego com assistente em tempo real"
  description="Pitchei é o copiloto que te lembra a melhor versão de si durante a entrevista — respostas no método STAR, exemplos do seu histórico, range salarial — tudo em português, sem o recrutador saber."
  path="/casos-de-uso/entrevistas-de-emprego"
  jsonLd={jsonLd}
  keywords={keywords}
>
  <Breadcrumb crumbs={crumbs} />

  <UseCaseHero
    eyebrow="Caso de uso · Candidatos"
    title="Entrevista de emprego: a resposta certa quando a mente trava."
    subtitle="Você prepara, você decora, e mesmo assim o branco vem. Pitchei te lembra os seus próprios exemplos — no método STAR, em português, no momento exato da pergunta."
  />

  <section class="border-b border-paper/10" aria-labelledby="por-que-entrevista">
    <div class="mx-auto max-w-4xl px-6 py-20">
      <p class="text-sm font-semibold uppercase tracking-wider text-orange">
        Por que entrevista é diferente de qualquer outra reunião
      </p>
      <h2 id="por-que-entrevista" class="mt-3 font-display text-3xl font-black leading-tight text-paper md:text-4xl">
        Você tem um exemplo perfeito. Ele só não vem na hora.
      </h2>
      <div class="mt-8 space-y-5 text-lg leading-relaxed text-paper/75">
        <p>
          "Conte uma situação em que você teve que lidar com um conflito difícil no time." Você sabe. Tem cinco. Mas em vez de escolher o melhor, sua cabeça trava entre os cinco e você acaba contando o quarto, sem força, sem resultado claro.
        </p>
        <p>
          Entrevista comportamental cobra exemplos estruturados — situação, tarefa, ação, resultado — e cobra dentro de <strong class="text-paper">cinco segundos de silêncio antes do recrutador anotar "candidato hesitou"</strong>. Pressão real.
        </p>
        <p>
          Pitchei te dá tempo. Você cadastra seus exemplos antes (uma vez, reaproveita em todas as entrevistas), e durante a conversa, ele identifica a pergunta e sugere qual exemplo da sua lista responde melhor, com a estrutura STAR pronta.
        </p>
      </div>
    </div>
  </section>

  <section class="border-b border-paper/10" aria-labelledby="como-resolve-entrevista">
    <div class="mx-auto max-w-5xl px-6 py-20">
      <p class="text-sm font-semibold uppercase tracking-wider text-orange">
        Como Pitchei te apoia na entrevista
      </p>
      <h2 id="como-resolve-entrevista" class="mt-3 font-display text-3xl font-black leading-tight text-paper md:text-4xl">
        Três tipos de pergunta, três jeitos de te ajudar.
      </h2>
      <ol class="mt-12 grid gap-6 md:grid-cols-3">
        <li class="rounded-2xl border border-paper/10 bg-paper/[0.03] p-7">
          <span class="font-display text-4xl font-black text-orange">01</span>
          <h3 class="mt-3 font-display text-xl font-bold text-paper">Pergunta comportamental</h3>
          <p class="mt-3 text-sm leading-relaxed text-paper/65">
            "Me conte uma vez em que…" Pitchei sugere o exemplo do seu CV que mais se encaixa, estruturado em STAR, com resultado numérico quando possível.
          </p>
        </li>
        <li class="rounded-2xl border border-paper/10 bg-paper/[0.03] p-7">
          <span class="font-display text-4xl font-black text-orange">02</span>
          <h3 class="mt-3 font-display text-xl font-bold text-paper">Pergunta sobre cultura e fit</h3>
          <p class="mt-3 text-sm leading-relaxed text-paper/65">
            "Como você trabalha sob pressão?" Pitchei traz o seu jeito real de trabalhar, conectado a um caso concreto — não a uma frase genérica de LinkedIn.
          </p>
        </li>
        <li class="rounded-2xl border border-paper/10 bg-paper/[0.03] p-7">
          <span class="font-display text-4xl font-black text-orange">03</span>
          <h3 class="mt-3 font-display text-xl font-bold text-paper">Pergunta sobre salário</h3>
          <p class="mt-3 text-sm leading-relaxed text-paper/65">
            Recrutador pede pretensão: Pitchei devolve o range que você definiu antes, com a justificativa pronta sobre seu nível e mercado.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <section class="border-b border-paper/10" aria-labelledby="exemplo-entrevista">
    <div class="mx-auto max-w-4xl px-6 py-20">
      <p class="text-sm font-semibold uppercase tracking-wider text-orange">
        Exemplo: pergunta comportamental
      </p>
      <h2 id="exemplo-entrevista" class="mt-3 font-display text-3xl font-black leading-tight text-paper md:text-4xl">
        Da pergunta cinco-em-um pra uma resposta clara.
      </h2>
      <div class="mt-10 space-y-4 rounded-2xl border border-paper/10 bg-paper/[0.03] p-8">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-paper/45">Recrutador</span>
          <p class="mt-1 text-paper/85">
            "Me conta uma situação em que você teve que tomar uma decisão difícil sem ter todos os dados que gostaria."
          </p>
        </div>
        <div class="border-t border-paper/10 pt-4">
          <span class="text-xs font-semibold uppercase tracking-wider text-orange">Sugestão do Pitchei (estrutura STAR)</span>
          <ul class="mt-2 space-y-2 text-paper/85">
            <li><strong class="text-paper">Situação:</strong> No projeto X, em Q3/2025, precisávamos decidir entre dois fornecedores em 48h.</li>
            <li><strong class="text-paper">Tarefa:</strong> Eu era responsável pelo go/no-go, sem dados completos de SLA.</li>
            <li><strong class="text-paper">Ação:</strong> Estabeleci três critérios irredutíveis, conversei com dois clientes-âncora dos dois fornecedores, e priorizei evidência qualitativa sobre brochure.</li>
            <li><strong class="text-paper">Resultado:</strong> A escolha rodou 14 meses sem incidente crítico. Reduziu custo em 18%.</li>
          </ul>
        </div>
        <div class="border-t border-paper/10 pt-4">
          <span class="text-xs font-semibold uppercase tracking-wider text-paper/45">Você fala</span>
          <p class="mt-1 text-paper/85">
            Sua história, seus números — só estruturados pra caber em 90 segundos de resposta clara.
          </p>
        </div>
      </div>
    </div>
  </section>

  <UseCaseFAQ
    title="Sobre Pitchei em entrevistas"
    items={faq}
  />

  <UseCaseCTA
    title="Prepare a próxima entrevista com um copiloto."
    subtitle="Cadastre seus exemplos uma vez e use em qualquer entrevista. Acesso ao beta gratuito na primeira coorte."
  />
</Base>
