---
import Base from "~/layouts/Base.astro";
import Breadcrumb from "~/components/Breadcrumb.astro";
import UseCaseCTA from "~/components/UseCaseCTA.astro";
import {
  breadcrumbSchema,
  collectionPageSchema,
  organizationSchema,
} from "~/lib/schema";

const crumbs = [
  { name: "Início", url: "/" },
  { name: "Casos de uso", url: "/casos-de-uso" },
];

const usos = [
  {
    href: "/casos-de-uso/pitch-para-investidores",
    title: "Pitch para investidores",
    desc: "O copiloto que devolve TAM, runway e o reframe certo durante o pitch.",
    persona: "Founders",
  },
  {
    href: "/casos-de-uso/entrevistas-de-emprego",
    title: "Entrevistas de emprego",
    desc: "Respostas no método STAR com seus próprios exemplos, em pt-BR, sob pressão.",
    persona: "Candidatos",
  },
  {
    href: "/casos-de-uso/vendas-e-negociacao",
    title: "Vendas e negociação",
    desc: "Reframes pra valor, perguntas de discovery, follow-up sólido, em tempo real.",
    persona: "Vendedores",
  },
  {
    href: "/casos-de-uso/reunioes-com-clientes",
    title: "Reuniões com clientes",
    desc: "Kickoff, status, QBR, renegociação. Memória contextual ao vivo.",
    persona: "CSMs e AMs",
  },
];

const jsonLd = [
  organizationSchema(),
  breadcrumbSchema(crumbs),
  collectionPageSchema({
    name: "Casos de uso · Pitchei",
    description:
      "Como o Pitchei te apoia durante cada tipo de reunião, pitch para investidores, entrevistas, vendas, calls com clientes.",
    path: "/casos-de-uso",
  }),
];

const keywords = [
  "casos de uso pitchei",
  "assistente de reunião com IA",
  "pitch para investidores",
  "entrevista de emprego",
  "vendas consultiva",
  "reunião com cliente",
];
---

<Base
  title="Casos de uso"
  description="Onde o Pitchei encaixa: pitch para investidores, entrevistas de emprego, vendas consultivas e reuniões com clientes. Em português, durante a conversa."
  path="/casos-de-uso"
  jsonLd={jsonLd}
  keywords={keywords}
>
  <Breadcrumb crumbs={crumbs} />

  <section class="border-b border-paper/10">
    <div class="mx-auto max-w-4xl px-6 py-20 md:py-28">
      <p class="text-sm font-semibold uppercase tracking-wider text-orange">
        Casos de uso
      </p>
      <h1 class="mt-3 font-display text-4xl font-black leading-tight text-paper md:text-6xl">
        Onde o Pitchei encaixa.
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-paper/75">
        Quatro tipos de conversa onde a próxima frase pesa, e onde um copiloto em português, ao vivo, muda o resultado.
      </p>
    </div>
  </section>

  <section class="border-b border-paper/10">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <div class="grid gap-6 md:grid-cols-2">
        {usos.map((u) => (
          <a
            href={u.href}
            class="group rounded-2xl border border-paper/10 bg-paper/[0.03] p-8 transition-all hover:border-orange/40 hover:bg-paper/[0.05]"
          >
            <span class="inline-flex rounded-full border border-orange/30 bg-orange/10 px-3 py-1 text-xs font-bold uppercase tracking-wider text-orange">
              {u.persona}
            </span>
            <h2 class="mt-5 font-display text-2xl font-bold text-paper group-hover:text-orange md:text-3xl">
              {u.title}
            </h2>
            <p class="mt-3 text-base text-paper/70">{u.desc}</p>
            <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-orange">
              Ver caso de uso
              <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <UseCaseCTA
    title="Pronto pra usar Pitchei no seu próximo momento?"
    subtitle="Independente do tipo de reunião, o copiloto é o mesmo. Entre na lista de espera."
  />
</Base>
