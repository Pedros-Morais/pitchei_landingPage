---
import Base from "~/layouts/Base.astro";
import Breadcrumb from "~/components/Breadcrumb.astro";
import HubHero from "~/components/HubHero.astro";
import HubCardGrid from "~/components/HubCardGrid.astro";
import UseCaseCTA from "~/components/UseCaseCTA.astro";
import {
  breadcrumbSchema,
  collectionPageSchema,
  organizationSchema,
} from "~/lib/schema";

const crumbs = [
  { name: "Início", url: "/" },
  { name: "Comparativos", url: "/comparativo" },
];

const comparativos = [
  {
    href: "/comparativo/pitchei-vs-otter",
    title: "Pitchei vs Otter",
    desc: "Copiloto ao vivo vs transcritor tradicional. Quando usar cada um.",
  },
  {
    href: "/comparativo/pitchei-vs-fathom",
    title: "Pitchei vs Fathom",
    desc: "Copiloto ao vivo vs notetaker com integração CRM. Diferenças e complementaridade.",
  },
];

const jsonLd = [
  organizationSchema(),
  breadcrumbSchema(crumbs),
  collectionPageSchema({
    name: "Comparativos · Pitchei",
    description:
      "Pitchei comparado com transcritores e notetakers populares: Otter, Fathom.",
    path: "/comparativo",
  }),
];

const keywords = [
  "pitchei vs otter",
  "pitchei vs fathom",
  "alternativa otter",
  "alternativa fathom",
  "comparativo transcritor reunião",
];
---

<Base
  title="Comparativos"
  description="Pitchei vs Otter e Fathom: um copiloto que fala durante a reunião contra transcritores que só resumem depois. Veja as diferenças e quando usar cada um."
  path="/comparativo"
  jsonLd={jsonLd}
  keywords={keywords}
>
  <Breadcrumb crumbs={crumbs} />

  <HubHero
    eyebrow="Comparativos"
    title="Onde Pitchei encaixa no seu stack."
    subtitle="Comparativos honestos entre Pitchei e as principais ferramentas de reunião. Não é briga, é mapa de quando usar o quê."
  />

  <HubCardGrid items={comparativos} ctaLabel="Ver comparativo" />

  <UseCaseCTA
    title="Quer testar Pitchei junto do seu stack atual?"
    subtitle="Pitchei roda em paralelo a qualquer transcritor. Entre na lista de espera."
  />
</Base>
