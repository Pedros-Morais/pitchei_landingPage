---
const rows = [
  { scribe: "Grava e transcreve", pitchei: "Escuta e sugere em tempo real" },
  { scribe: "Valor entregue depois da reunião", pitchei: "Valor entregue durante a reunião" },
  { scribe: "Passivo — apenas registra", pitchei: "Ativo — intervém quando precisa" },
  { scribe: "Substitui anotações", pitchei: "Substitui insegurança" },
  { scribe: "Foco: documentação", pitchei: "Foco: performance" },
];
---

<section
  class="relative border-b border-paper/10"
  aria-labelledby="problema-titulo"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10"
    style="background: linear-gradient(180deg, transparent 0%, rgba(247,243,238,0.02) 100%);"
  ></div>

  <div class="mx-auto max-w-6xl px-6 py-20 md:py-28">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-wider text-orange">
        Diferente de tudo que você já testou
      </p>
      <h2
        id="problema-titulo"
        class="mt-3 font-display text-4xl font-black leading-tight text-paper md:text-5xl"
      >
        Pitchei não é um transcritor. É um co-piloto.
      </h2>
      <p class="mt-5 text-lg text-paper/70">
        Otter, Fathom, Granola, Krisp — todos entregam o resumo da reunião
        depois que ela acabou. Ótimo para registro. Inútil quando você está
        no momento, e a próxima frase é a que decide a venda, o pitch, o
        contrato.
      </p>
    </div>

    <div class="mt-12 overflow-hidden rounded-2xl border border-paper/10 bg-paper/[0.03] shadow-overlay">
      <div class="grid grid-cols-2 border-b border-paper/10 bg-paper/[0.03]">
        <div class="px-6 py-4 text-sm font-semibold uppercase tracking-wider text-paper/50">
          Transcritores (Otter, Fathom, Granola)
        </div>
        <div class="border-l border-paper/10 px-6 py-4 text-sm font-semibold uppercase tracking-wider text-orange">
          Pitchei
        </div>
      </div>
      {rows.map((row) => (
        <div class="grid grid-cols-2 border-b border-paper/10 last:border-b-0">
          <div class="px-6 py-5 text-sm text-paper/60 md:text-base">
            {row.scribe}
          </div>
          <div class="border-l border-paper/10 px-6 py-5 text-sm font-medium text-paper md:text-base">
            {row.pitchei}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
