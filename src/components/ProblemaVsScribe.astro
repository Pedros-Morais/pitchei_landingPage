---
const rows = [
  { scribe: "Grava e transcreve", pitchei: "Escuta e sugere em tempo real" },
  { scribe: "Só entende o que é falado", pitchei: "Ouve o áudio e lê a sua tela" },
  { scribe: "Valor entregue depois da reunião", pitchei: "Valor entregue durante a reunião" },
  { scribe: "Passivo, apenas registra", pitchei: "Ativo, responde quando precisa" },
  { scribe: "Substitui anotações", pitchei: "Substitui a insegurança" },
  { scribe: "Foco: documentação", pitchei: "Foco: performance" },
];
---

<section
  class="relative border-b border-paper/10"
  aria-labelledby="problema-titulo"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10"
    style="background: linear-gradient(180deg, transparent 0%, rgba(247,243,238,0.02) 100%);"
  ></div>

  <div class="mx-auto max-w-6xl px-6 py-20 md:py-28">
    <div class="max-w-3xl" data-reveal-stagger>
      <p class="text-sm font-semibold uppercase tracking-wider text-orange">
        Diferente de tudo que você já testou
      </p>
      <h2
        id="problema-titulo"
        data-h2-split
        class="mt-3 font-display text-4xl font-black leading-tight text-paper md:text-5xl"
      >
        O Pitchei não é um transcritor de reunião. É um copiloto.
      </h2>
      <p class="mt-5 text-lg text-paper/70">
        Otter, Fathom, Granola e Krisp entregam o resumo da reunião depois que
        ela acabou. Ótimo para registro, inútil no exato momento em que a
        próxima frase decide a venda, o pitch ou o contrato.
      </p>
    </div>

    <div
      class="relative mt-12 overflow-hidden rounded-2xl border border-paper/10 bg-paper/[0.03] shadow-overlay"
      data-reveal
    >
      {/* Header sheen on reveal */}
      <div class="grid grid-cols-2 border-b border-paper/10 bg-paper/[0.03]">
        <div class="px-3 py-4 text-[11px] font-semibold uppercase leading-snug tracking-wide text-paper/50 sm:px-6 sm:text-sm sm:tracking-wider">
          Transcritores (Otter, Fathom, Granola)
        </div>
        <div class="relative overflow-hidden border-l border-paper/10 px-3 py-4 text-[11px] font-semibold uppercase leading-snug tracking-wide text-orange sm:px-6 sm:text-sm sm:tracking-wider">
          Pitchei
          <span
            aria-hidden="true"
            class="pointer-events-none absolute inset-0"
            style="background: linear-gradient(115deg, transparent 30%, rgba(232,93,38,0.18) 50%, transparent 70%); animation: sheen 1200ms ease-out 600ms both;"
          ></span>
        </div>
      </div>

      <div data-reveal-stagger>
        {rows.map((row) => (
          <div class="grid grid-cols-2 border-b border-paper/10 last:border-b-0">
            <div class="px-3 py-4 text-xs leading-relaxed text-paper/60 sm:px-6 sm:py-5 sm:text-sm md:text-base">
              {row.scribe}
            </div>
            <div class="border-l border-paper/10 px-3 py-4 text-xs font-medium leading-relaxed text-paper sm:px-6 sm:py-5 sm:text-sm md:text-base">
              {row.pitchei}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
