---
const personas = [
  {
    tag: "Vendas",
    titulo: "Para quem vende em call",
    bullet:
      "Sugere perguntas de descoberta, contorna objeções comuns e oferece próximos passos no fechamento.",
    cenas: [
      "Cliente fala em preço; Pitchei sugere a reframe pra valor.",
      "Conversa esfria; Pitchei propõe a pergunta que abre a próxima oportunidade.",
      "Final da call; Pitchei lembra de pedir o follow-up com data.",
    ],
  },
  {
    tag: "Pitch",
    titulo: "Para founders em pitch",
    bullet:
      "Responde dúvidas técnicas e de mercado em tempo real, com base no que você já configurou sobre a empresa.",
    cenas: [
      "Investidor pergunta de TAM; Pitchei traz o número certo do seu briefing.",
      "Pergunta sobre concorrência; Pitchei sugere o ângulo de diferenciação.",
      "Você trava; Pitchei devolve o pitch para o slide seguinte.",
    ],
  },
];
---

<section
  id="para-quem"
  class="border-b border-paper/10"
  aria-labelledby="personas-titulo"
>
  <div class="mx-auto max-w-6xl px-6 py-20 md:py-28">
    <div class="max-w-3xl" data-reveal-stagger>
      <p class="text-sm font-semibold uppercase tracking-wider text-orange">
        Para quem é
      </p>
      <h2
        id="personas-titulo"
        class="mt-3 font-display text-4xl font-black leading-tight text-paper md:text-5xl"
      >
        Para conversas que importam, em português.
      </h2>
      <p class="mt-5 text-lg text-paper/70">
        Pitchei nasceu para o profissional brasileiro que vende, pitcha e
        negocia em pt-BR. Sem traduzir o que importa.
      </p>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-2" data-reveal-stagger>
      {personas.map((p) => (
        <article class="magnetic-glow group relative flex flex-col overflow-hidden rounded-2xl border border-paper/10 bg-paper/[0.03] p-8 transition-colors hover:bg-paper/[0.05] hover:border-paper/20">
          <span class="relative inline-flex w-fit overflow-hidden rounded-full border border-orange/30 bg-orange/10 px-3 py-1 text-xs font-bold uppercase tracking-wider text-orange">
            {p.tag}
            <span
              aria-hidden="true"
              class="pointer-events-none absolute inset-0 opacity-0 group-hover:opacity-100"
              style="background: linear-gradient(115deg, transparent 30%, rgba(232,93,38,0.4) 50%, transparent 70%); animation: sheen 900ms ease-out;"
            ></span>
          </span>
          <h3 class="relative mt-5 font-display text-2xl font-bold text-paper">
            {p.titulo}
          </h3>
          <p class="relative mt-3 text-base text-paper/70">{p.bullet}</p>
          <ul class="relative mt-6 space-y-3 text-sm text-paper/65">
            {p.cenas.map((c) => (
              <li class="flex gap-3">
                <span aria-hidden="true" class="mt-1 inline-block h-1.5 w-1.5 flex-shrink-0 rounded-full bg-orange"></span>
                <span>{c}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
