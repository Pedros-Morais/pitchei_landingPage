---
import Logo from "./Logo.astro";
---

<header class="sticky top-0 z-40 border-b border-paper/10 bg-ink/85 backdrop-blur-md">
  <nav
    aria-label="Principal"
    class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4"
  >
    <a
      href="/"
      class="flex items-center gap-2 transition-opacity hover:opacity-80"
      aria-label="Pitchei — página inicial"
    >
      <Logo height={28} />
    </a>
    <div class="hidden items-center gap-7 text-sm font-medium text-paper/70 md:flex">
      <a href="/casos-de-uso" class="transition-colors hover:text-paper">Casos de uso</a>
      <a href="/comparativo" class="transition-colors hover:text-paper">Comparativos</a>
      <a href="/blog" class="transition-colors hover:text-paper">Blog</a>
      <a href="/sobre" class="transition-colors hover:text-paper">Sobre</a>
    </div>
    <a
      href="/#cadastro"
      data-magnetic
      class="inline-flex items-center rounded-full bg-orange px-5 py-2.5 text-sm font-semibold text-paper transition-colors hover:bg-orange-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-paper"
    >
      Entrar na lista
    </a>
  </nav>
</header>
