---
import Logo from "./Logo.astro";
---

<header class="sticky top-0 z-40 border-b border-paper/10 bg-ink/90 backdrop-blur-md">
  <nav
    aria-label="Principal"
    class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-5 py-3 sm:px-6 sm:py-4"
  >
    <a
      href="/"
      class="flex items-center gap-2 transition-opacity hover:opacity-80"
      aria-label="Pitchei — página inicial"
    >
      <Logo height={28} />
    </a>
    <div class="hidden items-center gap-7 text-sm font-medium text-paper/70 md:flex">
      <a href="/casos-de-uso" class="transition-colors hover:text-paper">Casos de uso</a>
      <a href="/comparativo" class="transition-colors hover:text-paper">Comparativos</a>
      <a href="/blog" class="transition-colors hover:text-paper">Blog</a>
      <a href="/sobre" class="transition-colors hover:text-paper">Sobre</a>
    </div>
    <div class="flex items-center gap-2 sm:gap-3">
      <a
        href="/#cadastro"
        data-magnetic
        class="inline-flex min-h-11 items-center rounded-full bg-orange px-4 py-2 text-sm font-semibold text-paper transition-colors hover:bg-orange-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-paper sm:px-5"
      >
        <span class="sm:hidden">Quero entrar</span>
        <span class="hidden sm:inline">Entrar na lista</span>
      </a>

      <details class="group relative md:hidden">
        <summary
          class="flex size-11 list-none items-center justify-center rounded-full border border-paper/15 text-paper transition-colors hover:bg-paper/5 [&::-webkit-details-marker]:hidden"
          aria-label="Abrir menu principal"
        >
          <svg class="group-open:hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
          <svg class="hidden group-open:block" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </summary>
        <div class="absolute right-0 top-[calc(100%+0.75rem)] w-[min(19rem,calc(100vw-2.5rem))] overflow-hidden rounded-2xl border border-paper/15 bg-ink shadow-overlay">
          <div class="flex flex-col p-2 text-base font-medium text-paper/75">
            <a href="/casos-de-uso" class="rounded-xl px-4 py-3 transition-colors hover:bg-paper/5 hover:text-paper">Casos de uso</a>
            <a href="/comparativo" class="rounded-xl px-4 py-3 transition-colors hover:bg-paper/5 hover:text-paper">Comparativos</a>
            <a href="/blog" class="rounded-xl px-4 py-3 transition-colors hover:bg-paper/5 hover:text-paper">Blog</a>
            <a href="/sobre" class="rounded-xl px-4 py-3 transition-colors hover:bg-paper/5 hover:text-paper">Sobre</a>
          </div>
        </div>
      </details>
    </div>
  </nav>
</header>
