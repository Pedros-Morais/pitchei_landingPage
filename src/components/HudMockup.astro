---
type Props = { class?: string };
const { class: className = "" } = Astro.props;

const scenes = [
  {
    speaker: "Interlocutor",
    transcript: "o ROI do projeto fechou em quanto?",
    suggestion:
      "Faz sentido revisitar com base nos números que você mencionou antes de fecharmos?",
  },
  {
    speaker: "Investidor",
    transcript: "qual o seu TAM no mercado brasileiro?",
    suggestion:
      "R$ 12B em SaaS B2B no Brasil — atacamos primeiro a densidade de founders em São Paulo.",
  },
  {
    speaker: "Cliente",
    transcript: "tô achando o preço meio salgado…",
    suggestion:
      "Se eu te mostrasse que o ROI cobre o custo no segundo mês, faria sentido?",
  },
];
---

<div
  class:list={[
    "hud-card relative w-full max-w-xl overflow-hidden rounded-2xl border border-paper/10 p-5 text-paper shadow-overlay",
    className,
  ]}
  style="background: linear-gradient(180deg, #2A1810 0%, #1C0F09 100%); aspect-ratio: 1.45 / 1; min-height: 360px;"
  aria-hidden="true"
>
  {/* Persistent header — live indicator + title + timer */}
  <div class="relative z-10 flex items-center gap-2 text-xs">
    <span class="relative inline-flex h-2 w-2">
      <span
        class="absolute inline-flex h-full w-full animate-pulse-soft rounded-full"
        style="background: #FF7A45"></span>
      <span class="relative inline-flex h-2 w-2 rounded-full" style="background: #FF7A45"></span>
    </span>
    <span class="font-medium tracking-wide text-paper/70">Pitchei · Ao vivo</span>
    <span class="ml-auto font-mono text-[11px] text-paper/40">12:34</span>
  </div>

  {/* 3 stacked scenes — animation-delay offsets them in time */}
  {scenes.map((s, i) => (
    <div class:list={["hud-scene", `hud-scene-${i + 1}`]}>
      <div class="hud-speaker text-[10px] font-semibold uppercase tracking-[0.14em] text-orange">
        {s.speaker}
      </div>
      <div class="mt-2 font-display text-base leading-snug text-paper/90 md:text-lg">
        <span class="hud-typewriter" style={`animation-delay: ${0.6 + i * 8}s; animation-duration: ${Math.max(1.6, s.transcript.length * 60)}ms;`}>
          "{s.transcript}"
        </span>
      </div>

      {/* thinking dots */}
      <div class="hud-thinking mt-3 flex items-center gap-1" style={`animation-delay: ${3.2 + i * 8}s;`}>
        <span class="hud-thinking-dot inline-block h-1.5 w-1.5 rounded-full bg-paper/40"></span>
        <span class="hud-thinking-dot inline-block h-1.5 w-1.5 rounded-full bg-paper/40"></span>
        <span class="hud-thinking-dot inline-block h-1.5 w-1.5 rounded-full bg-paper/40"></span>
      </div>

      {/* suggestion */}
      <div
        class="hud-suggestion mt-2 rounded-xl border border-orange/20 bg-orange/[0.06] p-4"
        style={`animation-delay: ${4.2 + i * 8}s;`}
      >
        <div class="font-display text-sm font-semibold leading-snug text-paper md:text-base">
          {s.suggestion}
        </div>
        <div class="mt-3 flex flex-wrap gap-2">
          <button
            type="button"
            tabindex="-1"
            class="hud-action rounded-full bg-orange px-3 py-1.5 text-[11px] font-semibold text-paper"
            style={`animation-delay: ${4.9 + i * 8}s;`}
          >
            Usar sugestão
          </button>
          <button
            type="button"
            tabindex="-1"
            class="hud-action rounded-full border border-paper/15 px-3 py-1.5 text-[11px] font-medium text-paper/80"
            style={`animation-delay: ${5.05 + i * 8}s;`}
          >
            Outra
          </button>
          <button
            type="button"
            tabindex="-1"
            class="hud-action rounded-full border border-paper/15 px-3 py-1.5 text-[11px] font-medium text-paper/80"
            style={`animation-delay: ${5.2 + i * 8}s;`}
          >
            Dispensar
          </button>
        </div>
      </div>
    </div>
  ))}

  {/* Ambient orange radial glow */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-16 -right-16 h-48 w-48 rounded-full"
    style="background: radial-gradient(circle, rgba(232,93,38,0.32) 0%, transparent 70%); animation: breath 8s ease-in-out infinite;"
  ></div>
</div>
