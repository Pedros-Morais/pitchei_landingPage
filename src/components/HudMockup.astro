---
type Props = { class?: string };
const { class: className = "" } = Astro.props;
---

<div
  class:list={[
    "hud-card relative w-full max-w-xl overflow-hidden rounded-2xl border border-paper/10 p-5 text-paper shadow-overlay",
    className,
  ]}
  style="background: linear-gradient(180deg, #2A1810 0%, #1C0F09 100%); aspect-ratio: 1.45 / 1; min-height: 360px;"
  aria-hidden="true"
>
  <div class="relative z-10 flex items-center gap-2 text-xs">
    <span class="relative inline-flex h-2 w-2">
      <span class="relative inline-flex h-2 w-2 rounded-full" style="background: #FF7A45"></span>
    </span>
    <span class="font-medium tracking-wide text-paper/70">Pitchei · Ao vivo</span>
    <span class="ml-auto font-mono text-[11px] text-paper/40">12:34</span>
  </div>

  <div class="mt-10">
    <div class="text-[10px] font-semibold uppercase tracking-[0.14em] text-orange">Cliente</div>
    <p class="mt-2 font-display text-base leading-snug text-paper/90 md:text-lg">
      "o ROI do projeto fechou em quanto?"
    </p>
    <div class="mt-5 rounded-xl border border-orange/20 bg-orange/[0.06] p-4">
      <p class="font-display text-sm font-semibold leading-snug text-paper md:text-base">
        Faz sentido revisitar com base nos números que você mencionou antes de fecharmos?
      </p>
      <div class="mt-3 flex flex-wrap gap-2">
        <span class="rounded-full bg-orange px-3 py-1.5 text-[11px] font-semibold text-paper"
          >Usar sugestão</span
        >
        <span
          class="rounded-full border border-paper/15 px-3 py-1.5 text-[11px] font-medium text-paper/80"
          >Outra</span
        >
        <span
          class="rounded-full border border-paper/15 px-3 py-1.5 text-[11px] font-medium text-paper/80"
          >Dispensar</span
        >
      </div>
    </div>
  </div>

  <div
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-16 -right-16 h-48 w-48 rounded-full"
    style="background: radial-gradient(circle, rgba(232,93,38,0.32) 0%, transparent 70%);"
  >
  </div>
</div>
