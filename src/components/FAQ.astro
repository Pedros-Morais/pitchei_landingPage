---
import { FAQ_ITEMS } from "~/lib/faq";
---

<section
  id="faq"
  class="border-b border-ink-faint bg-paper-muted"
  aria-labelledby="faq-titulo"
>
  <div class="mx-auto max-w-4xl px-6 py-20 md:py-28">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-wider text-orange">
        Perguntas frequentes
      </p>
      <h2
        id="faq-titulo"
        class="mt-3 font-display text-4xl font-black leading-tight text-ink md:text-5xl"
      >
        Antes de você perguntar.
      </h2>
    </div>

    <div class="mt-12 divide-y divide-ink-faint overflow-hidden rounded-2xl border border-ink-faint bg-paper">
      {FAQ_ITEMS.map((item, i) => (
        <details class="group" open={i === 0}>
          <summary class="flex cursor-pointer items-center justify-between gap-4 px-6 py-5 font-display text-lg font-bold text-ink marker:hidden [&::-webkit-details-marker]:hidden">
            {item.question}
            <span
              aria-hidden="true"
              class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-paper-muted text-ink-muted transition-transform group-open:rotate-45"
            >
              +
            </span>
          </summary>
          <div class="px-6 pb-6 pt-1 text-base leading-relaxed text-ink-muted">
            {item.answer}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
