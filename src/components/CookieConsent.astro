---
---

<div
  data-cookie-consent
  class="fixed inset-x-0 bottom-0 z-50 hidden"
  role="dialog"
  aria-label="Preferências de cookies"
>
  <div class="mx-auto flex max-w-6xl flex-col gap-4 border-t border-paper/10 bg-ink/95 px-6 py-5 shadow-overlay backdrop-blur-md sm:flex-row sm:items-center sm:justify-between">
    <p class="max-w-2xl text-sm text-paper/75">
      Usamos cookies de analytics (Google Analytics) para entender como o site é usado. Isso é
      opcional e não afeta o funcionamento do Pitchei. Veja mais na
      <a href="/privacidade" class="text-orange underline-offset-2 hover:underline">Política de Privacidade</a>.
    </p>
    <div class="flex shrink-0 items-center gap-3">
      <button
        type="button"
        data-cookie-decline
        class="rounded-full border border-paper/15 px-4 py-2 text-sm font-medium text-paper/80 transition-colors hover:bg-paper/5"
      >
        Recusar
      </button>
      <button
        type="button"
        data-cookie-accept
        class="rounded-full bg-orange px-4 py-2 text-sm font-semibold text-paper transition-colors hover:bg-orange-hover"
      >
        Aceitar
      </button>
    </div>
  </div>
</div>

<script>
  import { getConsent, setConsent } from "~/lib/consent";
  import { loadAnalytics } from "~/scripts/analytics";

  function boot() {
    const banner = document.querySelector<HTMLElement>("[data-cookie-consent]");
    if (!banner || banner.dataset.bound === "true") return;
    banner.dataset.bound = "true";

    const show = () => banner.classList.remove("hidden");
    const hide = () => banner.classList.add("hidden");

    const consent = getConsent();
    if (consent === "granted") {
      loadAnalytics();
    } else if (consent === null) {
      show();
    }

    banner.querySelector("[data-cookie-accept]")?.addEventListener("click", () => {
      setConsent("granted");
      loadAnalytics();
      hide();
    });

    banner.querySelector("[data-cookie-decline]")?.addEventListener("click", () => {
      setConsent("denied");
      hide();
    });

    // Footer "Preferências de cookies" link reopens the banner instead of navigating.
    document.querySelectorAll<HTMLAnchorElement>('a[href="#cookie-preferences"]').forEach((link) => {
      if (link.dataset.bound === "true") return;
      link.dataset.bound = "true";
      link.addEventListener("click", (e) => {
        e.preventDefault();
        show();
      });
    });
  }

  boot();
  document.addEventListener("astro:page-load", boot);
</script>
