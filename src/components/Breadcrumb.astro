---
import type { Crumb } from "~/lib/schema";

type Props = {
  crumbs: Crumb[];
};

const { crumbs } = Astro.props;
---

<nav aria-label="Você está aqui" class="border-b border-paper/10 bg-paper/[0.02]">
  <ol class="mx-auto flex max-w-6xl flex-wrap items-center gap-2 px-6 py-3 text-xs text-paper/55">
    {crumbs.map((c, i) => (
      <li class="flex items-center gap-2">
        {i > 0 && (
          <span aria-hidden="true" class="text-paper/30">›</span>
        )}
        {i === crumbs.length - 1 ? (
          <span aria-current="page" class="text-paper/85">{c.name}</span>
        ) : (
          <a
            href={c.url}
            class="transition-colors hover:text-paper"
          >
            {c.name}
          </a>
        )}
      </li>
    ))}
  </ol>
</nav>
