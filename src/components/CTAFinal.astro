---
// Cadastro = waitlist. O `action` é um placeholder até decidirmos backend
// (Supabase, Formspree, ou rota Astro `prerender = false`). Mantém HTML semântico
// para que o form seja indexável e funcional sem JS.
---

<section
  id="cadastro"
  class="bg-ink text-paper"
  aria-labelledby="cadastro-titulo"
  data-surface="overlay"
>
  <div class="mx-auto max-w-4xl px-6 py-24 text-center md:py-32">
    <p class="text-sm font-semibold uppercase tracking-wider text-orange">
      Lista de espera
    </p>
    <h2
      id="cadastro-titulo"
      class="mt-3 font-display text-4xl font-black leading-tight md:text-6xl"
    >
      Os primeiros 100 entram no beta.
    </h2>
    <p class="mx-auto mt-5 max-w-2xl text-lg text-paper/70 md:text-xl">
      Cadastre seu email e a gente te chama assim que abrir uma vaga. Sem
      spam. Você pode sair quando quiser.
    </p>

    <form
      action="https://formspree.io/f/REPLACE_ME"
      method="POST"
      class="mx-auto mt-10 flex w-full max-w-xl flex-col gap-3 sm:flex-row"
    >
      <label class="sr-only" for="email-cadastro">Email</label>
      <input
        id="email-cadastro"
        type="email"
        name="email"
        required
        autocomplete="email"
        placeholder="seu@email.com"
        class="flex-1 rounded-full border border-paper/15 bg-paper/5 px-6 py-3.5 text-base text-paper placeholder:text-paper/40 focus:border-orange focus:outline-none focus:ring-2 focus:ring-orange/40"
      />
      <input type="hidden" name="origem" value="landing-pt-br" />
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
      <button
        type="submit"
        class="inline-flex items-center justify-center rounded-full bg-orange px-7 py-3.5 text-base font-semibold text-paper transition-colors hover:bg-orange-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-paper"
      >
        Quero entrar
      </button>
    </form>
    <p class="mt-4 text-xs text-paper/50">
      A gente respeita LGPD. Email só pra te avisar do beta — nada além disso.
    </p>
  </div>
</section>
