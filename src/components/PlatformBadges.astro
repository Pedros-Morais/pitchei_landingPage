---
// Mostra que o Pitchei roda em Mac e Windows. Herda cor (currentColor) e
// tamanho da fonte do contexto onde for usado. Passe `iconClass` para ajustar
// o tamanho dos ícones e `class` para o espaçamento do grupo.
type Props = { class?: string; iconClass?: string };
const { class: className = "", iconClass = "h-4 w-4" } = Astro.props;
---

<span class:list={["inline-flex items-center gap-4", className]}>
  <span class="inline-flex items-center gap-1.5">
    <svg
      class:list={[iconClass]}
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path
        d="M17.05 12.04c-.03-2.6 2.12-3.85 2.22-3.91-1.21-1.77-3.1-2.01-3.77-2.04-1.6-.16-3.13.94-3.94.94-.81 0-2.07-.92-3.4-.9-1.75.03-3.36 1.02-4.26 2.58-1.82 3.16-.46 7.83 1.3 10.4.86 1.25 1.88 2.66 3.22 2.61 1.29-.05 1.78-.83 3.34-.83 1.56 0 2 .83 3.37.81 1.39-.03 2.27-1.28 3.12-2.54.98-1.45 1.39-2.86 1.41-2.93-.03-.01-2.71-1.04-2.74-4.12M14.53 4.41c.71-.86 1.19-2.06 1.06-3.25-1.02.04-2.26.68-3 1.54-.66.76-1.24 1.98-1.08 3.15 1.14.09 2.31-.58 3.02-1.44"
      ></path>
    </svg>
    <span>Mac</span>
  </span>
  <span class="inline-flex items-center gap-1.5">
    <svg
      class:list={[iconClass]}
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path d="M3 4h8v8H3zM13 4h8v8h-8zM3 14h8v8H3zM13 14h8v8h-8z"></path>
    </svg>
    <span>Windows</span>
  </span>
</span>
