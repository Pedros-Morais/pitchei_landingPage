---
import HudMockup from "./HudMockup.astro";
import PlatformBadges from "./PlatformBadges.astro";
import AppleMark from "./AppleMark.astro";
import { SITE } from "~/lib/site";

const macDownload = SITE.downloads.macOS;
---

<section
  class="relative isolate overflow-hidden border-b border-paper/10"
  aria-labelledby="hero-titulo"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 z-0 bg-[radial-gradient(circle_at_18%_20%,rgba(255,179,71,0.20),transparent_30%),radial-gradient(circle_at_82%_10%,rgba(255,122,69,0.16),transparent_28%),linear-gradient(90deg,rgba(28,15,9,0.90)_0%,rgba(28,15,9,0.62)_48%,rgba(28,15,9,0.82)_100%)]"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 bottom-0 z-0 h-32 bg-gradient-to-b from-transparent to-ink"
  >
  </div>
  <div
    class="relative z-10 mx-auto grid max-w-6xl items-center gap-8 px-5 py-14 sm:px-6 md:py-20 lg:grid-cols-12 lg:gap-12 lg:py-28"
  >
    <div class="lg:col-span-7">
      <p
        class="hero-meta mb-5 inline-flex items-center gap-2 rounded-full border border-paper/15 bg-paper/5 px-3 py-1 text-[11px] font-medium uppercase tracking-wider text-paper/70 sm:text-xs"
      >
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-orange"></span>
        Beta para macOS · disponível agora
      </p>
      <h1 id="hero-titulo" class="font-display text-hero font-black text-paper">
        <span class="hero-line">O parceiro que </span>
        <span class="hero-line"
          ><em class="hero-fala font-display italic text-orange">fala</em></span
        >
        <span class="hero-line">quando você precisa.</span>
      </h1>
      <p class="hero-sub mt-5 max-w-[34ch] text-hero-sub text-paper/75 md:max-w-xl">
        Pitchei ouve a conversa e lê a tela em tempo real. Sugere o que dizer em pt-BR, ao vivo,
        durante a reunião.
      </p>
      <div class="hero-cta mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap md:mt-10">
        <a
          href={macDownload.url}
          target="_blank"
          rel="noreferrer"
          class="btn-shine inline-flex w-full items-center justify-center gap-2 rounded-full bg-orange px-6 py-3 text-base font-semibold text-paper shadow-glow-soft transition-colors hover:bg-orange-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-paper sm:w-auto md:px-7 md:py-3.5"
        >
          <AppleMark class="size-4" />
          Baixar para macOS
        </a>
        <button
          type="button"
          data-voice-trigger
          hidden
          class="btn-mic inline-flex w-full items-center justify-center gap-2 rounded-full border border-paper/20 bg-paper/0 px-6 py-3 text-base font-semibold text-paper transition-all hover:border-paper/30 hover:bg-paper/5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-paper sm:w-auto md:px-7 md:py-3.5"
          aria-label="Diga uma frase pra Pitchei responder ao vivo"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="9" y="2" width="6" height="12" rx="3"></rect>
            <path d="M5 10v2a7 7 0 0 0 14 0v-2"></path>
            <line x1="12" y1="19" x2="12" y2="22"></line>
          </svg>
          <span data-voice-trigger-label>Diga uma frase</span>
        </button>
        <a
          href="#como-funciona"
          class="inline-flex w-full items-center justify-center rounded-full border border-paper/20 px-6 py-3 text-base font-semibold text-paper transition-all hover:border-paper/30 hover:bg-paper/5 sm:w-auto md:px-7 md:py-3.5"
        >
          Ver como funciona
        </a>
      </div>
      <div
        class="hero-foot mt-5 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-paper/50 md:mt-6"
      >
        <PlatformBadges class="gap-3 font-medium text-paper/70" />
        <span aria-hidden="true" class="h-1 w-1 rounded-full bg-paper/25"></span>
        <span>{macDownload.details}</span>
        <span aria-hidden="true" class="h-1 w-1 rounded-full bg-paper/25"></span>
        <span>DMG assinado e notarizado</span>
      </div>
    </div>

    <div class="relative flex justify-center lg:col-span-5 lg:justify-end">
      <div
        data-hud-3d-root
        data-hud-mode="loop"
        data-active-scene="0"
        class="relative w-full max-w-xl"
      >
        <div data-hud-front class="hud-enter">
          <HudMockup />
        </div>

        {/* Ghost cards: hidden until 3D mounts */}
        <div
          data-hud-ghost="mid"
          class="border-paper/8 pointer-events-none absolute inset-0 hidden rounded-2xl border p-5 opacity-0"
          style="background: linear-gradient(180deg, rgba(42,24,16,0.85) 0%, rgba(28,15,9,0.85) 100%); filter: blur(4px);"
          aria-hidden="true"
        >
          <div class="flex items-center gap-2 text-xs text-paper/40">
            <span class="inline-block h-1.5 w-1.5 rounded-full" style="background: #FF7A45"></span>
            <span class="font-medium tracking-wide">Pitchei · Ao vivo</span>
          </div>
          <div data-ghost-line class="mt-4 font-display text-base text-paper/40">…</div>
        </div>

        <div
          data-hud-ghost="back"
          class="border-paper/8 pointer-events-none absolute inset-0 hidden rounded-2xl border opacity-0"
          style="background: rgba(28,15,9,0.85); filter: blur(8px);"
          aria-hidden="true"
        >
          <div class="p-5">
            <div class="h-1.5 w-1.5 rounded-full" style="background: #FF7A45"></div>
            <div data-ghost-line class="mt-4 h-3 w-3/4 rounded-full bg-paper/10"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
