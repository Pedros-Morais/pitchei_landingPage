---
import HudMockup from "./HudMockup.astro";
---

<section
  class="relative overflow-hidden border-b border-paper/10"
  aria-labelledby="hero-titulo"
>
  {/* Animated background orbs */}
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div
      class="orb animate-orbit-slow-cw"
      style="
        top: -10%; left: -8%;
        width: 520px; height: 520px;
        background: radial-gradient(circle, rgba(232,93,38,0.28) 0%, transparent 60%);
      "
    ></div>
    <div
      class="orb animate-orbit-slow-ccw"
      style="
        top: 5%; right: -10%;
        width: 460px; height: 460px;
        background: radial-gradient(circle, rgba(255,179,71,0.20) 0%, transparent 60%);
      "
    ></div>
    <div
      class="orb animate-breath"
      style="
        bottom: -20%; left: 35%;
        width: 600px; height: 600px;
        background: radial-gradient(circle, rgba(255,122,69,0.18) 0%, transparent 65%);
      "
    ></div>
  </div>

  <div class="mx-auto grid max-w-6xl items-center gap-12 px-6 py-20 md:py-28 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <p class="hero-meta mb-6 inline-flex items-center gap-2 rounded-full border border-paper/15 bg-paper/5 px-3 py-1 text-xs font-medium uppercase tracking-wider text-paper/70">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-orange"></span>
        Em desenvolvimento — beta fechado em maio
      </p>
      <h1
        id="hero-titulo"
        class="font-display text-5xl font-black leading-[1.05] text-paper md:text-6xl lg:text-7xl"
      >
        <span class="hero-line">O parceiro que </span>
        <span class="hero-line"><em class="hero-fala font-display italic text-orange">fala</em></span>
        <span class="hero-line">quando você precisa.</span>
      </h1>
      <p class="hero-sub mt-6 max-w-xl text-lg leading-relaxed text-paper/75 md:text-xl">
        Pitchei ouve sua reunião em tempo real e sugere o que dizer — em
        português, durante a conversa, sem ninguém saber. Para quando você
        sabe a resposta, mas não está achando.
      </p>
      <div class="hero-cta mt-10 flex flex-col gap-3 sm:flex-row">
        <a
          href="#cadastro"
          class="btn-shine inline-flex items-center justify-center rounded-full bg-orange px-7 py-3.5 text-base font-semibold text-paper shadow-glow-soft transition-colors hover:bg-orange-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-paper"
        >
          Entrar na lista de espera
        </a>
        <a
          href="#como-funciona"
          class="inline-flex items-center justify-center rounded-full border border-paper/20 px-7 py-3.5 text-base font-semibold text-paper transition-all hover:bg-paper/5 hover:border-paper/30"
        >
          Ver como funciona
        </a>
      </div>
      <p class="hero-foot mt-6 text-sm text-paper/50">
        macOS 13 ou superior · sem cartão · cancela quando quiser
      </p>
    </div>

    <div class="relative flex justify-center lg:col-span-5 lg:justify-end">
      <div
        data-hud-3d-root
        class="relative w-full max-w-xl"
        style="min-height: 360px;"
      >
        <div data-hud-front class="hud-enter">
          <HudMockup />
        </div>

        {/* Ghost cards: hidden until 3D mounts */}
        <div
          data-hud-ghost="mid"
          class="pointer-events-none absolute inset-0 hidden rounded-2xl border border-paper/8 p-5 opacity-0"
          style="background: linear-gradient(180deg, rgba(42,24,16,0.85) 0%, rgba(28,15,9,0.85) 100%); filter: blur(4px);"
          aria-hidden="true"
        >
          <div class="flex items-center gap-2 text-xs text-paper/40">
            <span class="inline-block h-1.5 w-1.5 rounded-full" style="background: #FF7A45"></span>
            <span class="font-medium tracking-wide">Pitchei · Ao vivo</span>
          </div>
          <div
            data-ghost-line
            class="mt-4 font-display text-base text-paper/40"
          >…</div>
        </div>

        <div
          data-hud-ghost="back"
          class="pointer-events-none absolute inset-0 hidden rounded-2xl border border-paper/8 opacity-0"
          style="background: rgba(28,15,9,0.85); filter: blur(8px);"
          aria-hidden="true"
        >
          <div class="p-5">
            <div class="h-1.5 w-1.5 rounded-full" style="background: #FF7A45"></div>
            <div data-ghost-line class="mt-4 h-3 w-3/4 rounded-full bg-paper/10"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
