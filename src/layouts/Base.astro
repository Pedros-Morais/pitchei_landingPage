---
import "~/styles/tokens.css";
import "~/styles/animations.css";
import { ClientRouter } from "astro:transitions";
import SEO from "~/components/SEO.astro";
import Nav from "~/components/Nav.astro";
import Footer from "~/components/Footer.astro";
import CookieConsent from "~/components/CookieConsent.astro";
import { SITE } from "~/lib/site";

type Props = {
  title: string;
  description?: string;
  path?: string;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    author?: string;
    section?: string;
    tags?: string[];
  };
  keywords?: string[];
};

const props = Astro.props;
const canonical = new URL(props.path ?? "/", SITE.url).toString();
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <!-- Google Analytics loads only after consent, see CookieConsent.astro -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" hreflang="pt-BR" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <meta name="color-scheme" content="dark" />
    <SEO {...props} />
    <ClientRouter fallback="swap" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="bg-ink text-paper antialiased font-sans" data-surface="overlay">
    <div class="scroll-progress" aria-hidden="true"></div>
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-orange focus:px-4 focus:py-2 focus:text-paper"
    >
      Pular para o conteúdo
    </a>
    <Nav />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
    <CookieConsent />

    <script>
      // Critical, lightweight interactivity — ships in the initial bundle.
      import "~/scripts/lenis.ts";
      import "~/scripts/reveal.ts";
      import "~/scripts/waitlist-form.ts";
      import "~/scripts/hud-tap.ts";
      // Self-lazy: these only register idle gates, the heavy chunks (Three/GSAP)
      // are dynamically imported later and only on capable devices.
      import "~/scripts/hero-3d-loader.ts";
      import "~/scripts/insane-loader.ts";

      // Voice demo pulls in Web Speech wiring plus hCaptcha/voice-client. It
      // only matters once the user reaches for the mic, so defer it off the
      // critical path to keep the initial bundle small.
      const loadVoiceDemo = () => {
        void import("~/scripts/voice-demo.ts");
      };
      const ric = (
        window as {
          requestIdleCallback?: (cb: () => void, opts?: { timeout: number }) => number;
        }
      ).requestIdleCallback;
      if (ric) ric(loadVoiceDemo, { timeout: 3000 });
      else window.setTimeout(loadVoiceDemo, 1200);
    </script>
  </body>
</html>
